{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "./.wxt/tsconfig.typecheck.tsbuildinfo",
    // The built-in AI globals (`Translator`, `LanguageDetector`, the Prompt API, …) are only
    // declared by this package, and TypeScript 7 no longer pulls `@types` packages in
    // automatically.
    "types": ["dom-chromium-ai"]
  }
}