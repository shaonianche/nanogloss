{
  "name": "nanogloss",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://github.com/shaonianche/nanogloss#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaonianche/nanogloss.git"
  },
  "bugs": "https://github.com/shaonianche/nanogloss/issues",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "description": "Select text on any page to translate on-device with Chrome's built-in Translator API.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:profile": "node scripts/test-profile.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.22.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-stately": "3.50.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "execa": "^10.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.33",
    "postcss-rem-to-responsive-pixel": "^7.0.9",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0",
    "wxt": "0.21.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  }
}