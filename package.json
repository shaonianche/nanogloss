{
  "name": "nanogloss",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "description": "Select text on any page and translate it with Chrome's built-in Translator API.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:profile": "node scripts/test-profile.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.23.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@wxt-dev/module-react": "^1.2.2",
    "execa": "^10.1.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "postcss-rem-to-responsive-pixel": "^7.0.8",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "0.21.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ]
  }
}