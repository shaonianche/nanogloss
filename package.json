{
  "name": "nanogloss",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "description": "Select text on any page and translate it with Chrome's built-in Translator API.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.22.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.15",
    "postcss-rem-to-responsive-pixel": "^7.0.4",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1",
    "wxt": "0.20.26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "download"
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ]
  }
}